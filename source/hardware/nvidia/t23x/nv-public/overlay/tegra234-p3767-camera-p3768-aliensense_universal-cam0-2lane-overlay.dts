	fragment@9 {
		target-path = "/";
		__overlay__ {
			tegra-camera-platform {
				modules {
					status = "okay";
					sensor_module2: module2 {
						status = "okay";
						position = "bottomright";
						orientation = "1";
						badge = "universal_centerright_aliensense";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							devname = "universal 10-001e";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/universal_e@1e";
						};
					};
				};
			};

			tegra-capture-vi {
				num-channels = <4>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";
					sensor_vi_port0: port@0 {
						reg = <0>;
						status = "okay";
						sensor_vi_in0: endpoint {
							status = "okay";
							vc-id = <1>;
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&sensor_csi_ch0_out>;
						};
					};
				};
			};
		};
	};

	fragment@10 {
		target-path = "/bus@0";
		__overlay__ {
			host1x@13e00000 {
				nvcsi@15a00000 {
					num-channels = <4>;
					#address-cells = <1>;
					#size-cells = <0>;
					sensor_csi_ch0: channel@0 {
						reg = <0>;
						status = "okay";
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							status = "okay";
							sensor_csi_ch0_port0: port@0 {
								reg = <0>;
								status = "okay";
								sensor_csi_ch0_in: endpoint@0 {
									status = "okay";
									port-index = <1>;
									bus-width = <2>;
									remote-endpoint = <&sensor_out_e>;
								};
							};
							sensor_csi_ch0_port1: port@1 {
								reg = <1>;
								status = "okay";
								sensor_csi_ch0_out: endpoint@1 {
									status = "okay";
									remote-endpoint = <&sensor_vi_in0>;
								};
							};
						};
					};
				};
			};
		};
	};

